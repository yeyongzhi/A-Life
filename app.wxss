@import "style/font.wxss";

page {
  --primary-color: #15559A;
  --defaut-color: #3a3a3a;
  --primary-background-color: #E9F1F6;
  --default-background-color: #FFFFFF;
  --defaut-text-color: #3a3a3a;
  --defaut-text-white-color: #e9e9e9;
  --defaut-shadow-color: #dddddd;
  --whiteColor: #FFFFFF;
  /* 边框 */
  --default-border-radius: 8px;
  --default-border-width: 2px;
  /* 文本大小 */
  --h1title-font-size: 18px;
  --content-font-size: 16px;
  --large-number-size: 20px;
  --default-number-size: 18px;
  --small-number-size: 16px;
  /* 边距 */
  --default-page-padding: 15px;
}
page {
  background-color: var(--primary-background-color);
  width: 750rpx;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  font-family: 'YEFONTManHuaTi';
}
.main_container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: var(--default-page-padding);
  box-sizing: border-box;
  background-color: var(--primary-background-color);
}
.primary_round_btn {
  height: 40px;
  box-sizing: border-box;
  padding: 5px 10px;
  background-color: var(--primary-color);
  border-radius: var(--default-border-radius);
  font-size: 18px;
  color: var(--defaut-text-white-color);
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 暂无数据样式 */
.empty_container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}
.empty_container_icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20px;
}
.empty_container_tips {
  font-size: 25px;
  color: var(--primary-color);
  font-family: "zhuxuanlv", "manhua";
}

/* 隐藏滚动条 */
scroll-view ::-webkit-scrollbar {
  display:none;
  width:0;
  height:0;
  color:transparent;
}

/* 全局添加按钮 */
.global_addBtn {
  position: fixed;
  right: 60rpx;
  bottom: 60rpx;
  width: 110rpx;
  height: 110rpx;
  line-height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 100rpx;
  color: #FFFFFF;
  z-index: 9999;
  background-color: var(--primary-color);
  border-radius: 50%;
}
.global_addimg {
  width: 80rpx;
  height: 80rpx;
}