page {
  --primary-color: #15559A;
  --defaut-color: #3a3a3a;
  --primary-background-color: #E9F1F6;
  --default-background-color: #FFFFFF;
  --defaut-text-color: #3a3a3a;
  --defaut-text-white-color: #e9e9e9;
  --defaut-shadow-color: #dddddd;
  --whiteColor: #FFFFFF;
  --default-border-radius: 8px;
}
page {
  background-color: var(--primary-background-color);
  width: 750rpx;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}
.main_container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: 10px;
  box-sizing: border-box;
  background-color: var(--primary-background-color);
}
.primary_round_btn {
  height: 40px;
  box-sizing: border-box;
  padding: 5px 10px;
  background-color: var(--primary-color);
  border-radius: var(--default-border-radius);
  font-size: 18px;
  color: var(--defaut-text-white-color);
  display: flex;
  justify-content: center;
  align-items: center;
}
