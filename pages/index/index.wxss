.welcome_container {
  width: 100%;
  height: 100%;
  color: var(--primary-color);
  font-family: "manhua";
  position: relative;
  font-weight: var(--default-font-weight);
}

.word1 {
  width: 100%;
  text-align: center;
  font-size: 80rpx;
  position: absolute;
  top: 20%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-weight: var(--bolder-font-weight);
}

.word2 {
  width: 100%;
  text-align: center;
  font-size: var(--huge-font-size);
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
}

.enter {
  padding: 30rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  position: absolute;
  bottom: 25%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
}
.enter_img {
  width: 50px;
  height: 50px;
}