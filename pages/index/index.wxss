.test {
  font-size: 50px;
  color: #3a3a3a;
}
.welcome_container {
  width: 100%;
  height: 100%;
  color: var(--primary-color);
  font-family: "zhuxuanlv";
  position: relative;
  font-weight: 600;
}

.word1 {
  width: 100%;
  text-align: center;
  font-size: 80rpx;
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.word2 {
  width: 100%;
  text-align: center;
  font-size: 22px;
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
}

.enter {
  padding: 30rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  font-size: 22px;
  position: absolute;
  bottom: 25%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
}