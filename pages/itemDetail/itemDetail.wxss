.itemdetail_container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: 10px;
  box-sizing: border-box;
}
.single_header {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.single_title_name {
  color: var(--primary-color);
  font-size: 22px;
  font-weight: bolder;
  white-space: normal;
}
.single_title_title {
  color: var(--defaut-text-color);
  font-size: 16px;
}
.single_handle {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}
.single_checkbox {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 1px solid var(--primary-color);
  background-color: var(--whiteColor);
}
.single_checkbox_active {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 1px solid var(--primary-color);
  background-color: var(--primary-color);
  display: flex;
  justify-content: center;
  align-items: center;
}
.single_content {
  border: 2px solid var(--primary-color);
  background-color: var(--whiteColor);
  height: 250px;
  border-radius: 8px;
  padding: 10px;
  margin-top: 10px;
}
.single_textarea {
  width: 100%;
  background-color: var(--whiteColor);
  height: 200px;
}
.save_box {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 10px;
}