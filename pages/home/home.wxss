.content_container {
  width: 100%;
  height: 100%;
}
.content_box {
  width: 100%;
  margin-bottom: 10px;
  box-sizing: border-box;
  border: 2px solid var(--primary-color);
  overflow: hidden;
  border-radius: var(--default-border-radius);
}
.content_header {
  width: 100%;
  box-sizing: border-box;
  padding: 0 10px;
  height: 50px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: var(--primary-color);
}
.content_header_title {
  font-size: 16px;
  font-weight: bolder;
  color: var(--whiteColor);
 
}
.content_header_progress {
  font-size: 20px;
  font-weight: bolder;
  padding: 5px 20px;
  border-radius: 20px;
  background-color: var(--whiteColor);
  color: var(--primary-color);
  display: flex;
  justify-content: center;
  align-items: center;
}
.content_content {
  max-height: 200px;
  padding: 10px;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  align-content: flex-start;
  gap: 10px;
  overflow: hidden;
}
.list_item_active {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: 16px;
  white-space: nowrap;
  border-radius: 5px;
  background-color: var(--primary-color);
  color: var(--whiteColor);
}
.list_item {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: 16px;
  white-space: nowrap;
  border-radius: 5px;
}