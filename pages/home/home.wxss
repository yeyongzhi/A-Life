.content_container {
  width: 100%;
  height: 100%;
}
.content_box {
  width: 100%;
  margin-bottom: 20px;
  box-sizing: border-box;
  border: var(--default-border-width) solid var(--primary-color);
  overflow: hidden;
  border-radius: var(--default-border-radius);
}
.content_header {
  width: 100%;
  box-sizing: border-box;
  padding: 0 10px;
  height: 50px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: var(--primary-color);
}
.content_header_title {
  font-size: var(--h1title-font-size);
  font-weight: bolder;
  color: var(--whiteColor);
 
}
.content_header_progress {
  font-size: var(--small-number-size);
  font-weight: bolder;
  padding: 3px 8px;
  border-radius: 20px;
  background-color: var(--whiteColor);
  color: var(--primary-color);
  display: flex;
  justify-content: center;
  align-items: center;
}
.content_content {
  max-height: 200px;
  padding: 10px;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  align-content: flex-start;
  gap: 10px;
  overflow: hidden;
}
.list_item_active {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: var(--content-font-size);
  white-space: nowrap;
  border-radius: 5px;
  background-color: var(--primary-color);
  color: var(--whiteColor);
}
.list_item {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: var(--content-font-size);
  white-space: nowrap;
  border-radius: 5px;
}
.celebrate_container {
  width: 100%;
  padding: 0 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 10px 0;
  color: var(--primary-color);
  font-size: var(--content-font-size);
  font-family: "zhuxuanlv";
  font-weight: bolder;
}
.celebrate_img {
  width: 30px;
  height: 30px;
  margin-right: 10px;
}