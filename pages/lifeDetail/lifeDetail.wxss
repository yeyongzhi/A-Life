.lifedetail_container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: 10px;
  box-sizing: border-box;
}
.content_container {
  height: calc(100% - 80px);
  border: var(--default-border-width) solid var(--primary-color);
  border-radius: var(--default-border-radius);
  overflow: hidden;
}
.content_header {
  width: 100%;
  box-sizing: border-box;
  padding: 0 10px;
  height: 80px;
  background-color: var(--primary-color);
  color: var(--whiteColor);
}
.content_header_title {
  height: 40px;
  line-height: 40px;
  width: 100%;
  text-align: left;
  font-size: var(--large-font-size);
  font-weight: bolder;
}
.content_header_description_box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 30px;
}
.content_header_description {
  margin-top: 5px;
  font-size: var(--content-font-size);
  font-weight: normal;
  color: var(--defaut-text-white-color);
}
.content_header_progress {
  font-size: var(--large-font-size);
  font-weight: bolder;
  height: 30px;
  width: 60px;
  border-radius: 20px;
  background-color: var(--whiteColor);
  color: var(--primary-color);
  display: flex;
  justify-content: center;
  align-items: center;
}
.content_list_length {
  width: 100%;
  height: 20px;
  line-height: 20px;
  margin-top: 10px;
  text-align: center;
  color: var(--primary-color);
  font-size: var(--content-font-size);
}
.content_list {
  height: calc(100% - 80px - 30px);
  overflow-x: hidden;
  overflow-y: auto;
  padding: 10px;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  align-content: flex-start;
  gap: 10px 10px;
}
.list_item_active {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: 16px;
  white-space: nowrap;
  border-radius: 5px;
  background-color: var(--primary-color);
  color: var(--whiteColor);
}
.list_item {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: 16px;
  white-space: nowrap;
  border-radius: 5px;
}
.handle_container {
  width: 100%;
  height: 60px;
  margin-top: 10px;
  box-sizing: border-box;
  padding: 0 10%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.handle_btn {
  width: 40%;
  height: 70%;
  background-color: var(--primary-color);
  color: var(--whiteColor);
  font-weight: bolder;
  font-size: 16px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 8px;
}