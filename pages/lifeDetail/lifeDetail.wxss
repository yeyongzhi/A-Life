.lifedetail_container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: 10px;
  box-sizing: border-box;
}
.content_container {
  height: calc(100% - 80px);
  border: 1px solid var(--primary-color);
}
.content_header {
  width: 100%;
  box-sizing: border-box;
  padding: 0 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 50px;
  background-color: var(--primary-color);
  color: var(--whiteColor);
}
.content_header_title {
  font-size: 16px;
  font-weight: bolder;
}
.content_header_progress {
  font-size: 20px;
  font-weight: bolder;
  padding: 5px 20px;
  border-radius: 20px;
  background-color: var(--whiteColor);
  color: var(--primary-color);
  display: flex;
  justify-content: center;
  align-items: center;
}
.handle_container {
  height: 60px;
  margin: 10px auto;
  border: 1px solid var(--primary-color);
}
.content_list {
  height: calc(100% - 50px);
  overflow-x: hidden;
  overflow-y: auto;
  padding: 10px;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  align-content: flex-start;
  gap: 20px 15px;
}
.list_item_active {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: 16px;
  white-space: nowrap;
  border-radius: 5px;
  background-color: var(--primary-color);
  color: var(--whiteColor);
}
.list_item {
  padding: 5px 10px;
  border: 1px solid var(--primary-color);
  font-size: 16px;
  white-space: nowrap;
  border-radius: 5px;
}
.handle_container {
  width: 100%;
  box-sizing: border-box;
  padding: 0 10%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.handle_btn {
  width: 40%;
  height: 70%;
  background-color: var(--primary-color);
  color: var(--whiteColor);
  font-weight: bolder;
  font-size: 16px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 8px;
}