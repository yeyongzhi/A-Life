<view class="main_container">
  <view class="content_container">
    <view class="content_header">
      <view class="content_header_title">{{ detail.title }}</view>
      <view class="content_header_description_box">
        <view class="content_header_description">{{ detail.description !== "" ? detail.description : '暂无描述' }}</view>
        <view class="content_header_progress">{{ progress }}%</view>
      </view>
    </view>
    <view class="content_list_length">共 {{ detail.list.length }} 个项</view>
    <!-- 内容区域 -->
    <view class="content_list">
      <view class="{{ item.isSelected ? 'list_item_active' : 'list_item' }}" wx:for="{{ detail.list }}" wx:key="index" data-item="{{ item }}" bind:tap="handleItemChanged" bind:longpress="handleItemLongpress">{{ item.name }}</view>
    </view>
  </view>
  <view class="handle_container">
    <!-- <view class="handle_btn">切换样式</view> -->
    <!-- <view class="handle_btn">生成图片</view> -->
    <view class="handle_btn" bind:tap="showMoreActions">更多操作</view>
  </view>
</view>