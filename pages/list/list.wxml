<view class="main_container">
	<view class="search_container">
		<input class="search-input" value="{{ searchWord }}" placeholder="请输入关键字搜索" bindinput="handleSearchChanged"/>
	</view>
	<view class="tag_container">
		<view class="tag_box {{ item.key === activeTag ? 'tag_active_box' : 'tag_default_box' }}" wx:for="{{tagList}}" wx:key="item.key" bind:tap="handleTagChanged" data-tagKey="{{ item.key }}">#{{ item.name }}</view>
	</view>
	<view class="content_container">
		<scroll-view scroll-y="true" class="content_scroll">
      <view wx:if="{{ searchLifeListData.length === 0 }}" class="empty_container">
        <image src="/static/images/empty.png" class="empty_container_icon" />
        <view class="empty_container_tips">暂未发现数据</view>
      </view>
			<view wx:else>
      <!-- 清单项 -->
        <!-- <view class="life_box" wx:for="{{ searchLifeListData }}" data-lifeid="{{ item.id }}" data-lifeindex="{{ index }}" bind:tap="gotoLifeDetail" bind:touchstart="handleTouchStart" bind:touchmove="handleTouchMove" bind:touchend="handleTouchEnd">
          <view class="life_box_all" style="left: {{ moveLeft[index] || 0 }}px;">
            <view class="life_box_left">
              <view class="life_box_title">{{ item.title }}</view>
              <view class="life_box_description">{{ item.description }}</view>
              <view class="life_box_content">{{ item.renderContent }}</view>
            </view>
            <view class="life_box_right">
              删除
            </view>
          </view>
        </view> -->
        <view class="life_box" wx:for="{{ searchLifeListData }}" data-lifeid="{{ item.id }}" data-lifeindex="{{ index }}" bind:tap="gotoLifeDetail" bind:longpress="handleLifOperation">
          <view class="life_box_common_all">
            <view class="life_box_common_left">
              <view class="life_box_common_title">
                <view>{{ item.title }}</view>
                <view>
                  <view class="global_tag" wx:if="{{ item.isDraft }}">草稿</view>
                </view>
              </view>
              <view class="life_box_common_description">{{ item.description }}</view>
              <view class="life_box_common_content">{{ item.renderContent }}</view>
            </view>
            <!-- <view class="life_box_common_right">
              删除按钮...
            </view> -->
          </view>
        </view>
        <view wx:if="{{ activeTag === 'all' }}" class="empty_container">
          <image src="/static/images/empty.png" style="width: 40px;height: 40px;margin-bottom: 10px;" class="empty_container_icon" />
          <view class="empty_container_tips" style="font-size: 16px;">已经滚到底啦</view>
        </view>
      </view>
		</scroll-view>
	</view>
  <view class="global_addBtn" bind:tap="gotoAddPage">
    <image class="global_addimg" src="/static/images/plus.png" />
  </view>
  <view wx:if="{{ isShowMask }}" class="mask_container" bind:tap="hideOpeartion">

  </view>
</view>