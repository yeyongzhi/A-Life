.search_container {
  width: 100%;
  height: 50px;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: var(--default-background-color);
  border-radius: var(--default-border-radius);
}
.search-input {
  width: 100%;
  padding: 0 20px;
  border-radius: var(--default-border-radius);
}
.tag_container {
  margin: 10px 0;
  width: 100%;
  box-sizing: border-box;
  height: 75px;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex-wrap: wrap;
  overflow-y: auto;
  gap: 10px;
}
.tag_box {
  height: 20px;
  line-height: 20px;
  text-align: center;
  border-radius: 5px;
}
.tag_default_box {
  padding: 5px 8px;
  border-radius: 5px;
  background-color: var(--default-background-color);
  color: var(--defaut-text-color);
  border: 1px solid var(--defaut-color);
}
.tag_active_box {
  padding: 5px 8px;
  border-radius: 5px;
  background-color: var(--primary-color);
  color: var(--defaut-text-white-color);
  border: 1px solid var(--primary-color);
}
.content_container {
  width: 100%;
  box-sizing: border-box;
  height: calc(100% - 50px - 75px - var(--default-page-padding) - var(--default-page-padding));
}
.content_scroll {
  height: 100%;
  /* padding: var(--default-page-padding) 0; */
}
.life_box {
  padding: 10px;
  background-color: var(--default-background-color);
  border-radius: 8px;
  margin-bottom: var(--default-page-padding);
  box-shadow: 2px 2px 2px var(--defaut-shadow-color);
  border: var(--default-border-width) solid var(--primary-color);
  /* position: relative;
  height: 110px; */
}
/* 普通版 */
.life_box_common_all {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.life_box_common_left {
  width: 100%;
}
.life_box_common_right {
  width: 18%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.life_box_common_title {
  width: 100%;
  font-size: 18px;
  font-weight: 600;
  height: 30px;
  line-height: 30px;
  color: var(--primary-color);
}
.life_box_common_description {
  width: 100%;
  font-size: 14px;
  color: var(--defaut-text-color);
  height: 20px;
  line-height: 20px;
  margin-top: 3px;
}
.life_box_common_content {
  width: 100%;
  font-size: 15px;
  color: var(--defaut-text-color);
  margin-top: 5px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

/* 滑动版 */
.life_box_all {
  position: absolute;
  left: 0;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  height: 110px;
}
.life_box_left {
  width: 100%;
  /* border: 1px solid #E20000; */
  flex-shrink: 0;
}
.life_box_right {
  flex-shrink: 0;
  width: 100px;
  border: 1px solid #1890ff;
}
.life_box_title {
  width: 100%;
  font-size: 18px;
  font-weight: 600;
  height: 30px;
  line-height: 30px;
}
.life_box_description {
  width: 100%;
  font-size: 14px;
  color: var(--defaut-text-color);
  opacity: 0.9;
  height: 20px;
  line-height: 20px;
}
.life_box_content {
  width: 100%;
  font-size: 15px;
  color: var(--defaut-text-color);
  margin-top: 10px;
  height: 50px;
  /* display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; */
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  line-height: 25px;
}
.mask_container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 8;
}