<view class="main_container">
	<scroll-view scroll-y="true" class="scroll_container hide_scrool_container" :show-scrollbar="false">
    <!-- 工具栏 -->
    <view class="tool_box">
      <image bind:tap="showMore" class="tool_img more_img" style="margin-top: 2px;" src="/static/images/more.png"/>
      <view class="showMore_box" wx:if="{{ showMoreVisible }}">
        <image class="morebox_img" src="/static/images/birthday.png" bind:tap="settingBirthday"/>
        <image class="morebox_img" src="/static/images/clear.png" bind:tap="clearData"/>
      </view>
      <!-- 遮罩 -->
      <view wx:if="{{ showMoreVisible }}" class="mask_bg" bind:tap="showMore"></view>
    </view>
		<!-- 介绍 -->
		<view class="sub_title">关于A Life</view>
		<view class="sub_content">
			<view class="sub_line">A Life 是一位帮你记录生活</view>
      <view class="sub_line">规划人生清单的朋友</view>
			<view class="sub_line">希望你充满面对未来的勇气</view>
			<view class="sub_line">一件一件地去尝试你所热爱的事</view>
			<view class="sub_line">在你的人生清单上</view>
			<view class="sub_line simle_box">
        画下属于你自己的：
        <image class="done_img" src="/static/images/doneBox.png"/>
      </view>
		</view>
		<view class="sub_title">联系我们</view>
		<view class="sub_content">
			<view class="sub_line">如果你有更多有意思的清单</view>
			<view class="sub_line">欢迎分享给我们</view>
			<view class="sub_line">如果没有，那也祝你今天开心</view>
			<view class="sub_line" style="margin-top: 20px;">
				<!-- <text bind:tap="" class="sub_link can_click_view">公众号</text> -->
				<!-- <text class="sub_link">/</text> -->
				<text bind:tap="copyWechat" class="sub_link can_click_view">Wechat</text>
        <text class="sub_link">/</text>
				<text bind:tap="copyEmail" class="sub_link can_click_view">邮箱</text>
			</view>
		</view>
    <view class="sub_title">分享</view>
    <view class="sub_content">
      <view class="sub_line">如果你觉得 A Life 对你有所帮助</view>
      <view class="sub_line share_box can_click_view" bind:tap="share">
        <image class="share_img" src="/static/images/share.png"/>
        <button class="share_btn" open-type="share">分享给朋友</button>
      </view>
    </view>
    <view class="sub_title">写在最后</view>
    <view class="sub_content">
      <view class="sub_line">祝我们，慢慢理解世界，慢慢更新自己</view>
      <view class="sub_line">2024 年末</view>
    </view>
		<!-- 底图 -->
		<!-- <image src="/static/images/header.png" class="header_img"/> -->
	</scroll-view>
</view>