.scroll_container {
  height: 100%;
}
.tool_box {
  width: 90%;
  margin: 0 auto;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  opacity: 0.9;
  margin-bottom: 10px;
  height: 30px;
}
.tool_img {
  width: 25px;
  height: 25px;
}
.morebox_img {
  width: 30px;
  height: 30px;
}
.more_img {
  position: relative;
}
.showMore_box {
  position: absolute;
  top: 40px;
  right: 6px;
  background-color: var(--whiteColor);
  padding: 15px 10px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 20px;
  border-radius: var(--default-border-radius);
  z-index: 999;
}
.showMore_box::after {
  content: "";
  position: absolute;
  top: -6px;
  right: 15px;
  width: 0;
  height: 0;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-bottom: 10px solid var(--whiteColor);
}
.header_img {
  width: 100%;
  height: 200px;
}
.sub_title {
  font-size: 28px;
  font-weight: bolder;
  color: var(--primary-color);
  width: 100%;
  text-align: center;
  font-family: "zhuxuanlv";
  margin-bottom: 20px;
}
.sub_content {
  font-size: 20px;
  font-weight: bolder;
  color: var(--primary-color);
  width: 100%;
  text-align: center;
  font-family: "zhuxuanlv";
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 40px;
}
.sub_line {
  margin-bottom: 10px;
}
.sub_link {
  margin-right: 10px;
}
.simle_box {
  position: relative;
  padding: 0 30px;
}
.done_img {
  position: absolute;
  width: 30px;
  height: 30px;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  margin-top: 2px;
}
.simle_img {
  position: absolute;
  transform: rotate(45);
  width: 25px;
  height: 25px;
  right: 0px;
  bottom: 0;
}
.mask_bg {
  width: 100vw;
  height: 100vh;
  position: fixed;
  z-index: 600;
}