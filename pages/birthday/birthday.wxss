.content_container {
  height: 80%;
  border: var(--default-border-width) solid var(--primary-color);
  border-radius: var(--default-border-radius);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: var(--primary-color);
}
.handle_container {
  height: 20%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.birthday_picker {
  font-family: "manhua";
  font-size: 30px;
  color: var(--primary-color);
  font-weight: bolder;
}
.content_text {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 18px;
}
.content_text_line {
  line-height: 30px;
}
.submit_btn {
  box-sizing: border-box;
  width: 100px;
  height: 40px;
  background-color: var(--primary-color);
  border-radius: var(--default-border-radius);
  font-size: 20px;
  color: var(--defaut-text-white-color);
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: "manhua";
}
.bolder_text {
  font-weight: bolder;
}