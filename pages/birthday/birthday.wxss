.content_container {
  height: 80%;
  border: var(--default-border-width) solid var(--primary-color);
  border-radius: var(--default-border-radius);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30px;
}
.handle_container {
  height: 20%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.birthday_picker {
  font-family: "zhuxuanlv";
  font-size: 30px;
  color: var(--primary-color);
  font-weight: bolder;
}
.submit_btn {
  box-sizing: border-box;
  width: 100px;
  height: 40px;
  background-color: var(--primary-color);
  border-radius: var(--default-border-radius);
  font-size: 20px;
  color: var(--defaut-text-white-color);
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: "zhuxuanlv";
}